# Riot dev key: https://developer.riotgames.com (se regenera cada 24 h).
# Sin key, la app arranca en MODO DEMO con datos de ejemplo.
RIOT_API_KEY=

# Plataforma por defecto del buscador.
# la1 = LAN · la2 = LAS · na1 · br1 · euw1 · eun1 · kr · jp1 · oc1 · tr1 · ru · ...
RIOT_DEFAULT_PLATFORM=la2

# Cuántas partidas se analizan por perfil (1..100).
# Más partidas = agregado por campeón más representativo, pero más lento.
RIOT_ANALYZE_COUNT=24

# Límites de la key. Defaults = key personal/dev (20/s y 100 cada 2 min).
# Con production key: 500 y 30000.
RIOT_RATE_LIMIT_PER_SECOND=20
RIOT_RATE_LIMIT_PER_2MIN=100

# Locale de Data Dragon para nombres de campeones (es_ES, es_MX, es_AR, en_US...).
DD_LOCALE=es_ES

# Forzar datos de ejemplo (solo para demos públicas sin key). En desarrollo el
# modo demo se activa solo; en producción hace falta RIOT_DEMO=1.
# RIOT_DEMO=1
