# Riot dev key: https://developer.riotgames.com (se regenera cada 24 h).
# Sin key, la app arranca en MODO DEMO con datos de ejemplo.
RIOT_API_KEY=

# Plataforma por defecto del buscador.
# la1 = LAN · la2 = LAS · na1 · br1 · euw1 · eun1 · kr · jp1 · oc1 · tr1 · ru · ...
RIOT_DEFAULT_PLATFORM=la2

# Cuántas partidas se analizan por perfil (1..100).
# Más partidas = agregado por campeón más representativo, pero más lento.
RIOT_ANALYZE_COUNT=24

# Límites de la key. Defaults = key personal/dev (20/s y 100 cada 2 min).
# Con production key: 500 y 30000.
RIOT_RATE_LIMIT_PER_SECOND=20
RIOT_RATE_LIMIT_PER_2MIN=100

# Corte por request: si Riot no contesta en este tiempo, se reintenta y, si no
# entra en el presupuesto de la vuelta, la vuelta se corta ordenadamente.
RIOT_REQUEST_TIMEOUT_MS=15000

# --- Ingesta por demanda (botón "Cargar todo el historial") -----------------
# Requests por vuelta de /api/sync. Con dev key (100 cada 2 min ≈ 0,83/s) 30
# requests son ~36 s; con production key se puede subir a 300.
RIOT_SYNC_CHUNK=30
# Tope de tiempo por vuelta (ms). Tiene que quedar por debajo del maxDuration
# de la función (60 s) para que alcance a liberar el lock y responder.
RIOT_SYNC_DEADLINE_MS=40000
# Requests que puede gastar una visita al perfil de un jugador desconocido.
RIOT_ONDEMAND_BUDGET=25

# Locale de Data Dragon para nombres de campeones (es_ES, es_MX, es_AR, en_US...).
DD_LOCALE=es_ES

# Forzar datos de ejemplo (solo para demos públicas sin key). En desarrollo el
# modo demo se activa solo; en producción hace falta RIOT_DEMO=1.
# RIOT_DEMO=1

# --- Base de datos (fase 2) -------------------------------------------------
# Local, gratis y sin cuentas: un archivo SQLite.
DATABASE_URL=file:./data/league.db
#
# Producción (Turso, plan free de 5 GB): descomentar y completar.
# DATABASE_URL=libsql://tu-db.turso.io
# DATABASE_AUTH_TOKEN=eyJ...

# --- Cron propio de ingesta (/api/cron, ADR-028) ----------------------------
# Secreto del endpoint. Sin esto el cron responde 503 y no toca la base.
# Generá uno con: openssl rand -hex 32
CRON_SECRET=
# Requests por tanda (comparte el rate limit de Riot con el sitio).
CRON_BUDGET=40
# Jugadores de la cola por tanda.
CRON_PLAYERS=3
# Tope de tiempo por tanda. Vercel Hobby corta la función a los 60 s.
CRON_DEADLINE_MS=45000
